# Every setting is optional; see src/jobq/config.py for the full list and defaults.
JOBQ_DATABASE_URL=postgresql://jobq:jobq@localhost:5432/jobq
JOBQ_REDIS_URL=redis://localhost:6379/0
JOBQ_LEASE_S=30
JOBQ_HEARTBEAT_INTERVAL_S=10
JOBQ_WORKER_CONCURRENCY=16
JOBQ_DEFAULT_RATE_PER_S=100
JOBQ_DEFAULT_BURST=200
JOBQ_LOG_LEVEL=INFO

# Client SDK
JOBQ_API_URL=http://localhost:8000
JOBQ_API_KEY=
